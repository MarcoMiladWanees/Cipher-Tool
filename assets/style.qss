/* =====================================================
   1. GLOBAL APPLICATION – Dark Kryptos Base
===================================================== */

QMainWindow {
    background-color: #0A1A2A;   /* Deep navy */
    font-family: "JetBrains Mono", "Fira Code", "Source Code Pro", monospace;
    color: #E8F4F8;
}


/* =====================================================
   2. GROUP BOX – Kryptos Panels
===================================================== */

QGroupBox {
    background-color: #0F2336;   /* Panel tone */
    border: 1px solid #1F3447;
    border-radius: 8px;
    margin-top: 20px;
    padding: 16px;
    font-weight: 600;
    font-size: 15px;
    color: #00D4FF;  /* Kryptos cyan accent */
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #6B8A99;
}


/* =====================================================
   3. INPUT FIELDS – Cipher Console Style
===================================================== */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #152A3D;
    border: 1px solid #1F3447;
    border-radius: 6px;
    padding: 10px;
    color: #E8F4F8;
    font-size: 16px;
    selection-background-color: #00D4FF;
    selection-color: #0A1A2A;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border: 1px solid #00D4FF;
}

/* Glow focus effect */
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00D4FF;
    background-color: #152A3D;
}

/* NEW: Placeholder text styling */
QLineEdit::placeholder, QTextEdit::placeholder, QPlainTextEdit::placeholder {
    color: #3D5A6E;
    font-style: italic;
}


/* =====================================================
   4. ERROR STATE – Critical Crypto Warning
===================================================== */

QLineEdit[urgent="true"], QTextEdit[urgent="true"], QPlainTextEdit[urgent="true"] {
    border: 1px solid #E05272;
    background-color: #1A1024;
    color: #F0A0B5;
}


/* =====================================================
   5. BUTTONS – Command Style
===================================================== */

QPushButton {
    background-color: #0F2336;
    border: 1px solid #1F3447;
    border-radius: 6px;
    padding: 8px 18px;
    font-weight: 600;
    font-size: 13px;
    color: #E8F4F8;
}

QPushButton:hover {
    border: 1px solid #00D4FF;
    color: #00D4FF;
}

QPushButton:pressed {
    background-color: #0A1A2A;
    border: 1px solid #009FBE;
}

/* PRIMARY ACTION – Encrypt */
QPushButton#primaryButton {
    background-color: #00D4FF;
    color: #0A1A2A;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #38E3FF;
}

/* NEW: ENCRYPT BUTTON – Kryptos Cyan */
QPushButton#encryptButton {
    background-color: #00D4FF;
    color: #0A1A2A;
    border: none;
    font-weight: 700;
}

QPushButton#encryptButton:hover {
    background-color: #38E3FF;
}

QPushButton#encryptButton:pressed {
    background-color: #009FBE;
}

/* NEW: DECRYPT BUTTON – Deep Blue */
QPushButton#decryptButton {
    background-color: #1A6FB5;
    color: #E8F4F8;
    border: none;
    font-weight: 700;
}

QPushButton#decryptButton:hover {
    background-color: #2488D4;
}

QPushButton#decryptButton:pressed {
    background-color: #145A8F;
}

/* BRUTEFORCE BUTTON – Warning Rose */
QPushButton#bruteforceButton {
    background-color: #1A1024;
    color: #E05272;
    border: 1px solid #E05272;
    font-weight: 700;
}

QPushButton#bruteforceButton:hover {
    background-color: #241530;
    color: #F0A0B5;
    border: 1px solid #F0A0B5;
}

QPushButton#bruteforceButton:pressed {
    background-color: #1A1024;
    border: 1px solid #C74460;
}

/* NEW: COPY BUTTON – Subtle Utility */
QPushButton#copyButton {
    background-color: transparent;
    color: #6B8A99;
    border: 1px solid #1F3447;
    font-weight: 600;
}

QPushButton#copyButton:hover {
    color: #00D4FF;
    border: 1px solid #00D4FF;
}

QPushButton#copyButton:pressed {
    color: #009FBE;
    border: 1px solid #009FBE;
}

/* CLEAR BUTTON – replace the clear button block */
QPushButton#clearButton {
    background-color: transparent;
    color: #6B8A99;
    border: 1px solid #1F3447;
    font-weight: 600;
}

QPushButton#clearButton:hover {
    color: #E05272;
    border: 1px solid #E05272;
}

QPushButton#clearButton:pressed {
    color: #C74460;
    border: 1px solid #C74460;
}

QPushButton#toggleButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#toggleButton:hover {
    background-color: #0F2336;
}

QPushButton#toggleButton:pressed {
    background-color: #152A3D;
}
QPushButton#toggleButton:disabled {
    background-color: transparent;
    border: none;
    border-radius: 6px;}

QPushButton#closeButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#closeButton:hover {
    background-color: #0F2336;

    }

QPushButton#closeButton:pressed {
    background-color: #152A3D;
}
QPushButton#closeButton:disabled {
    background-color: transparent;
    border: none;
    border-radius: 6px;}


/* =====================================================
   6. COMBOBOX – Algorithm Selector
===================================================== */

QComboBox {
    border: 1px solid #1F3447;
    border-radius: 6px;
    padding: 6px 14px;
    background-color: #152A3D;
    color: #E8F4F8;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #00D4FF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #1F3447;
}

QComboBox::down-arrow {
    image: url(assets/down-arrow-dark.png); /* Use cyan or light arrow icon */
    width: 10px;
    height: 10px;
}


/* Dropdown list */
QAbstractItemView {
    border: 1px solid #1F3447;
    background-color: #0F2336;
    selection-background-color: #00D4FF;
    selection-color: #0A1A2A;
    color: #E8F4F8;
    outline: none;
}


/* =====================================================
   7. SCROLLBAR – Minimal Cyber Style
===================================================== */

QScrollBar:vertical {
    border: none;
    background: #0A1A2A;
    width: 8px;
    margin: 4px 0 4px 0;
}

QScrollBar::handle:vertical {
    background: #1F3447;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #00D4FF;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}


/* =====================================================
   8. NEW: TOOLTIPS – Kryptos Info Style
===================================================== */

QToolTip {
    background-color: #0F2336;
    color: #E8F4F8;
    border: 1px solid #00D4FF;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}


/* =====================================================
   9. NEW: LABELS – Text Hierarchy
===================================================== */

QLabel#titleLabel {
    color: #00D4FF;
    font-size: 30px;
    font-weight: 700;
}

QLabel#heroLabel {
    color: #00D4FF;
    font-size: 56px;
    font-weight: 700;
    letter-spacing: 12px;
}

QLabel#subtitleLabel {
    color: #6B8A99;
    font-size: 17px;
    font-weight: 400;
    font-style: italic;
}

QLabel#quoteLabel {
    color: #6B8A99;
    font-size: 16px;
    font-weight: 400;
    font-style: italic;
}

/* Status / info labels */
QLabel#statusLabel {
    color: #4ADE80;
    font-size: 11px;
    font-weight: 600;
}

/* Error labels */
QLabel#errorLabel {
    color: #E05272;
    font-size: 11px;
    font-weight: 600;
}

/* Muted / secondary labels */
QLabel#mutedLabel {
    color: #3D5A6E;
    font-size: 11px;
}

QLabel#hintLabel {
    color: #3D5A6E;
    font-size: 14px;
}

QLabel#paramLabel {
    color: #6B8A99;
    font-size: 15px;
    font-weight: 600;
}


/* =====================================================
   10. NEW: STATUS BAR – Bottom Info Strip
===================================================== */

QStatusBar {
    background-color: #0F2336;
    color: #6B8A99;
    border-top: 1px solid #1F3447;
    font-size: 11px;
    padding: 4px 12px;
}

QStatusBar::item {
    border: none;
}


/* =====================================================
   11. NEW: MENU BAR – Top Navigation (for v4)
===================================================== */

QMenuBar {
    background-color: #0A1A2A;
    color: #E8F4F8;
    border-bottom: 1px solid #1F3447;
    padding: 2px 0px;
}

QMenuBar::item {
    padding: 6px 14px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #152A3D;
    color: #00D4FF;
}

QMenu {
    background-color: #0F2336;
    border: 1px solid #1F3447;
    border-radius: 6px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 8px 24px;
    color: #E8F4F8;
}

QMenu::item:selected {
    background-color: #152A3D;
    color: #00D4FF;
}

QMenu::separator {
    height: 1px;
    background-color: #1F3447;
    margin: 4px 12px;
}


/* =====================================================
   12. NEW: TAB WIDGET – For Future Cipher Pages (v4)
===================================================== */

QTabWidget::pane {
    border: 1px solid #1F3447;
    border-radius: 6px;
    background-color: #0F2336;
}

QTabBar::tab {
    background-color: #0A1A2A;
    color: #6B8A99;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #1F3447;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #0F2336;
    color: #00D4FF;
    border-bottom: 2px solid #00D4FF;
}

QTabBar::tab:hover:!selected {
    color: #E8F4F8;
    background-color: #152A3D;
}

/* =====================================================
   SIDEBAR – Navigation Tree
===================================================== */

QTreeWidget {
    background-color: #0A1A2A;
    border: none;
    outline: none;
    padding: 8px 0px;
}

QTreeWidget::item {
    padding: 4px 12px;
    border-radius: 4px;
    margin: 1px 0px;
    color: #6B8A99;
}

QTreeWidget::item:selected {
    background-color: #152A3D;
    color: #00D4FF;
    border-left: 3px solid #00D4FF;
}

QTreeWidget::item:hover:!selected {
    background-color: #0F2336;
    color: #00D4FF;
}

QTreeWidget::branch {
    background-color: #0A1A2A;
    border: none;
}

QTreeWidget::branch:has-children:closed {
    image: none;
}

QTreeWidget::branch:has-children:open {
    image: none;
}

QHeaderView::section {
    background-color: #0A1A2A;
    color: #6B8A99;
    border: none;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
}


/* =====================================================
   14. NEW: SPLITTER – Panel Divider (for v4)
===================================================== */

QSplitter::handle {
    background-color: #1F3447;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #00D4FF;
}


/* =====================================================
   15. NEW: SPINBOX – Numeric Key Inputs (for v4)
===================================================== */

QSpinBox {
    background-color: #152A3D;
    border: 1px solid #1F3447;
    border-radius: 6px;
    padding: 6px 10px;
    color: #E8F4F8;
    font-size: 13px;
}

QSpinBox:hover {
    border: 1px solid #00D4FF;
}

QSpinBox:focus {
    border: 2px solid #00D4FF;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #0F2336;
    border: none;
    width: 20px;
}
QSpinBox::up-arrow {
    image: url(assets/chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(assets/chevron-down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #152A3D;
}


/* =====================================================
   16. NEW: DISABLED STATE – Locked Elements
===================================================== */

QPushButton:disabled {
    background-color: #0F2336;
    color: #3D5A6E;
    border: 1px solid #1F3447;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #0A1A2A;
    color: #3D5A6E;
    border: 1px solid #152A3D;
}

QComboBox:disabled {
    background-color: #0A1A2A;
    color: #3D5A6E;
    border: 1px solid #152A3D;
}

QLabel#playfairCell{
    background-color: #0A1A2A;
    border: 1px solid #1F3447;
    border-radius: 8px;
    color: #00D4FF;
    font-size: 20px ;
    font-weight: 700;
    font-family: "JetBrains Mono", "Fira Code", "Source Code Pro", monospace;

}
QLabel#playfairCell:hover{
    background-color: #0F2336 ;
    border: 1px solid #00D4FF;


}
#playfairGridContainer{
    background-color: #0A1A2A;
    border: 1px solid #1F3447;
    border-radius: 8px;
}
